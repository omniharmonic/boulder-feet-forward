            "buttonLabel": "",
            "buttonLink": {
              "type": "url",
              "url": "https://www.zeffy.com/en-US/donation-form/support-our-work-48"
            },
            "buttonStyle": "outline",
            "heading": "Fund something specific",
            "intro": "",
            "items": [
              {
                "approx": true,
                "impact": "$19 buys food for about 10 meals.",
                "link": {
                  "type": "url",
                  "url": "https://www.zeffy.com/en-US/donation-form/sponsor-community-meals"
                },
                "linkLabel": "Fund this",
                "summary": "Purchased food fills the gaps in donated food, so we can serve about 458 nutritious meals every month.",
                "title": "Community meals"
              },
              {
                "approx": true,
                "impact": "$27 stocks about 100 care items.",
                "link": {
                  "type": "url",
                  "url": "https://www.zeffy.com/en-US/donation-form/sponsor-personal-care-supplies"
                },
                "linkLabel": "Fund this",
                "summary": "About 11,360 hygiene, first-aid and personal care items a year. People choose what they need, rather than getting pre-made kits.",
                "title": "Personal care supplies"
              },
              {
                "approx": true,
                "impact": "$5 pays for one wash-and-dry load.",
                "link": {
                  "type": "url",
                  "url": "https://www.zeffy.com/en-US/donation-form/sponsor-our-laundry-program"
                },
                "linkLabel": "Fund this",
                "summary": "Twenty vouchers a month at Wash and Wave in North Boulder, so people can reuse clothing, blankets and sleeping bags.",
                "title": "Laundry program"
              },
              {
                "approx": true,
                "impact": "$14 buys a ten-ride pass.",
                "link": {
                  "type": "url",
                  "url": "https://www.zeffy.com/en-US/donation-form/sponsor-our-transportation-and-mobility-program"
                },
                "linkLabel": "Fund this",
                "summary": "Half-price RTD passes through the nonprofit program: at least 370 rides a month to appointments, food banks, shelter and services.",
                "title": "Transportation and mobility"
              }
            ],
            "note": "",
            "summary": "Choose what your gift does. Amounts are estimates from our recent costs."
          }
        }
      ]
