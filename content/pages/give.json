          "fields": {
            "buttonLabel": "Open the wish list",
            "buttonLink": {
              "type": "url",
              "url": "https://a.co/08YXvcyJ"
            },
            "buttonStyle": "outline",
            "heading": "Give things",
            "intro": "Our outreach events use single-use food service items, and we aim to use mostly compostable supplies. We also hand out seasonal survival gear. Our Amazon wish list lists what we use and distribute, and anything ordered ships directly to us.",
            "items": [],
            "note": "",
            "summary": "Your gently used items go to neighbors according to need.",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Donating items yourself"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The things our neighbors can use most:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Bikes, bike locks and bicycle repair supplies"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Sturdy backpacks and other luggage"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Mobility aids such as canes, walkers and crutches"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Camping gear"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Water bottles"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Email us",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "mailto:libby@feetforwardboulder.org"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " to arrange a drop-off. For clothing and shoes, please contact "
                    },
                    {
                      "type": "text",
                      "text": "Deacon’s Closet",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://www.deaconscloset.org/"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". For furniture, contact "
                    },
                    {
                      "type": "text",
                      "text": "Home Ahead",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://www.homeahead.org/"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". We are glad to send you to partners who can use those."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
