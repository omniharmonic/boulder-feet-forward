  "sections": [
    {
      "id": "sec_9m6th3tc7v",
      "label": "Boulder Feet Forward exists to enable…",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        }
      },
      "style": {
        "colorTheme": "light"
      },
      "blocks": [
        {
          "id": "blk_p234jxnwpj",
          "type": "component/imported-about-1",
          "v": 1,
          "fields": {
            "text1": "Boulder Feet Forward exists to enable and support stability.",
            "text2": "We are peers. We are members of our community.",
            "text3": "We visit our neighbors every day.",
            "text4": "And we do what we can to meet our community’s needs.",
            "text5": "We offer meals to those who are hungry.",
            "text6": "We offer supplies to those who need them.",
            "text7": "We offer our presence to those who just want to talk.",
            "text8": "We find resources for those who ask.",
            "text9": "We offer our guidance as peers to those who want it.",
            "text10": "We offer our advocacy as case managers to those who are ready to progress.",
            "text11": "We believe in a person-first approach: no single solution fits every individual, and we’re here to help each person find the one that works best for them.",
            "text12": "Everything we do keeps in mind that each person is the main character in their own story.",
            "text13": "We’re here to support, not to prescribe.",
            "text14": "We’re here to help establish and build self-sufficiency.",
            "text15": "We’re here each day, letting our neighbors and peers know they can come to us for help when they’re ready.",
            "text16": "We’re here each day to provide what stabilization we can until then.",
            "text17": "We’re here each day so that our neighbors and peers get to know us, and come to understand that when they’re ready, our focus will be on their personal journey and their own definition of success.",
            "text18": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Every day. Step by step.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
