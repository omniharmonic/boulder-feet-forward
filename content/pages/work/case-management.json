                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The long game, at your pace."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "lead"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Sustained support toward goals people set for themselves."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_z5wnbtqz6j",
