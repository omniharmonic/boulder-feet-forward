        {
          "id": "blk_eg9qzy492n",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We don’t duplicate the larger system of care. We extend its reach, working with existing providers and care teams so people can get services they might otherwise never reach."
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "preset": "starter/stack-12@1"
