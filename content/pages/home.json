    {
      "id": "sec_s8t6x4d2gd",
      "preset": "component/imported-home-5@1",
      "label": "Small steps add up.",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "wide"
      },
      "style": {
        "colorTheme": "light",
