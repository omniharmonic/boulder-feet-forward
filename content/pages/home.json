        }
      },
      "blocks": [
        {
          "id": "blk_90vqqnrh7p",
          "type": "component/section-heading",
          "v": 1,
          "fields": {
            "heading": "We meet people where they are. Then we keep showing up.",
            "lead": "If someone isn’t ready today, we show up again tomorrow. When they are ready, we’re already there.",
            "rule": true
          }
        },
        {
          "id": "blk_kk93a75n57",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Our peers are members of this community, and every relationship starts from trust, authenticity and equality. We listen to what people tell us about why they will not use the usual systems, and we build a different way to reach them."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_jcda8a1yrw",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "See what we do",
            "link": {
              "type": "page",
              "page": "pg_4a5crrg8h0"
            },
            "role": "secondary"
          }
        }
      ]
    },
    {
      "id": "sec_r1zar0fhp3",
      "preset": "starter/stack-12@1",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        }
      },
      "style": {
        "colorTheme": "light",
        "background": {
          "type": "color",
          "color": "#e9e6d2"
        },
        "padding": {
          "d": "lg",
          "m": "md"
        }
      },
      "blocks": [
        {
          "id": "blk_6tby97jp8j",
          "type": "component/section-heading",
          "v": 1,
          "fields": {
            "heading": "There is no single pathway out of homelessness.",
            "lead": "",
            "rule": true
          }
        },
        {
          "id": "blk_gtvtbh9z78",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Housing matters. But four walls and a roof do not automatically create health, stability, community, purpose or home. So we ask what this person needs to move forward, not which program they fit into. Choose a dimension of wellness to see how we help."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
