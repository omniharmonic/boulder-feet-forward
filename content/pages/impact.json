      "blocks": [
        {
          "id": "blk_0n4jfgq0pa",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "The numbers",
            "level": "h2",
            "size": "auto",
            "subheading": "In a typical week, we meet about 120 different people."
          },
          "variant": "plain"
        },
        {
          "id": "blk_1bd1p9tvxf",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Across both weekly events. About 85 come to Tuesdays in the Park."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We have served 13,705 meals since 2024."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Every day, our peers answer about 10 questions about where to find something, who to call, or what comes next."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "About two or three times a week, someone connects with a stabilizing resource, with our help."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Each year, about 20 people we have worked with reach stable housing."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_rpvn5w8whd",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "heading": "5",
                "body": {
                  "type": "doc",
                  "content": []
                }
              },
              {
                "heading": "10",
                "body": {
                  "type": "doc",
                  "content": []
                }
              },
              {
                "heading": "5",
                "body": {
                  "type": "doc",
                  "content": []
                }
              }
            ],
            "columns": "3",
            "aspect": "4:5"
          }
        },
        {
          "id": "blk_epm4phw28e",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Of the people who reach housing with us as their primary support, 4 out of 5 found their own way there."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Self-resolutions are individual paths home that the person chose and pursued."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Volunteers gave about 424 hours at Tuesday events in 2024, worth at least $16,959."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Tuesday outreach only. Friday hours are not included."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Numbers as of October 2026, from the Boulder Feet Forward information packet."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
