                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "What showing up adds up to."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "lead"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "We count what we can and say plainly what we cannot claim."
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "label": "Page head"
    },
