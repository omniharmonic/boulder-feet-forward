                    "level": 1
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "What showing up adds up to."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We count what we can and say plainly what we cannot claim."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_bw07gf206y",
      "preset": "starter/stack-12@1",
