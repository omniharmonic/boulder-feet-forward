                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Questions people ask."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_w8s8541ttv",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Who can volunteer?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anyone who wants to be a good neighbor. Please confirm age limits and any orientation requirements with us before your first shift. "
                        },
                        {
                          "type": "text",
                          "text": "(Draft: Libby to confirm minimum age and orientation.)",
                          "marks": [
                            {
                              "type": "italic"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What should I wear or bring?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Closed-toe shoes and weather-appropriate layers. We provide everything else. "
                        },
                        {
                          "type": "text",
                          "text": "(Draft: Libby to confirm.)",
                          "marks": [
                            {
                              "type": "italic"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can my group, school or business volunteer together?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Groups often help with meals, supplies and special events. Email us with your group size and a few dates that could work. "
                        },
                        {
                          "type": "text",
                          "text": "(Draft: Libby to confirm group size limits.)",
                          "marks": [
                            {
                              "type": "italic"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "How are my hours counted?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "At the end of each shift, our shift lead confirms who was there. Confirmed hours are recorded, and they count toward a monthly bus pass at three or more hours a week."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": false
          }
        }
      ],
      "preset": "starter/stack-12@1"
    }
  ]
