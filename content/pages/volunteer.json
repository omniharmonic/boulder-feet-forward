                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Friday Breakfast Club"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Arrive a little early. Our shift lead will show you the ropes before we start."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Coming with a group, or want to share a skill like yoga, art or poetry? Tell us about it"
                    }
                  ]
                }
              ]
