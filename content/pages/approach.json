      "style": {
        "colorTheme": "light"
      },
      "blocks": [
        {
          "id": "blk_36mes8rzvm",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "We stick around for the long haul.",
            "level": "h2",
            "size": "auto",
            "subheading": "We start with daily successes, then help build an individualized path forward. That might mean supportive housing, student housing, family reunification, becoming a live-in caregiver, meaningful employment, finding roommates, or saving for an RV."
          },
          "variant": "plain"
        },
        {
          "id": "blk_0ze1axfxx2",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "There is more than one way home."
                    }
                  ]
                }
              ]
            }
          }
        },
