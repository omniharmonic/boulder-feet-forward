{
  "name": "contact-columns",
  "label": "Find us / call or write",
  "description": "Two columns: where and when to find the team in the park (with the next dates worked out automatically), and how to call, email or write.",
  "version": 1,
  "category": "contact",
  "fields": {
    "address": {
      "kind": "text",
      "label": "Mailing address",
      "maxLength": 120
    },
    "callHeading": {
      "kind": "text",
      "label": "Call heading",
      "maxLength": 60
    },
    "emailLabel": {
      "kind": "text",
      "label": "Email",
      "maxLength": 80
    },
    "emailLink": {
      "kind": "link",
      "label": "Email link"
    },
    "nextDays": {
      "kind": "list",
      "label": "Next dates to show",
      "fields": {
        "label": {
          "kind": "text",
          "label": "Label",
          "maxLength": 40
        },
        "weekday": {
          "kind": "select",
          "label": "Day of the week",
          "options": [
            "sunday",
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday"
          ]
        }
      }
    },
    "parkHeading": {
      "kind": "text",
      "label": "Park heading",
      "maxLength": 60
    },
    "parkNote": {
      "kind": "text",
      "label": "Park note",
      "maxLength": 160
    },
    "phoneLabel": {
      "kind": "text",
      "label": "Phone",
      "maxLength": 40
    },
    "phoneLink": {
      "kind": "link",
      "label": "Phone link"
    },
    "schedule": {
      "kind": "list",
      "label": "Schedule lines",
      "fields": {
        "detail": {
          "kind": "text",
          "label": "Detail",
          "maxLength": 120
        },
        "name": {
          "kind": "text",
          "label": "Name (bold)",
          "optional": true,
          "maxLength": 60
        }
      }
    },
    "social": {
      "kind": "richText",
      "label": "Follow along line",
      "marks": [
        "bold",
        "italic",
        "link"
      ],
      "blocks": [
        "paragraph"
      ],
      "maxLength": 400
    }
  },
  "defaults": {
    "address": "PO Box 241, Boulder, CO 80306",
    "callHeading": "Call or write.",
    "emailLabel": "libby@feetforwardboulder.org",
    "emailLink": {
      "email": "libby@feetforwardboulder.org",
      "type": "email"
    },
    "nextDays": [
      {
        "label": "Next Tuesday",
        "weekday": "tuesday"
      },
      {
        "label": "Next Friday",
        "weekday": "friday"
      }
    ],
    "parkHeading": "Come to the park.",
    "parkNote": "All are welcome.",
    "phoneLabel": "720-520-2097",
    "phoneLink": {
      "phone": "+17205202097",
      "type": "phone"
    },
    "schedule": [
      {
        "detail": ", 2:30 PM",
        "name": "Tuesdays in the Park"
      },
      {
        "detail": ", 11:00 AM, with drop-in hours right after",
        "name": "Friday Breakfast Club"
      },
      {
        "detail": "Central Park, Boulder",
        "name": ""
      }
    ],
    "social": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Follow along: "
            },
            {
              "type": "text",
              "text": "Facebook",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://www.facebook.com/profile.php?id=61558925265378"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "text",
              "text": "Instagram",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://www.instagram.com/boulderfeetforward/"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "text",
              "text": "X",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://x.com/BoCoFeetForward"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "template": "<div class=\"cc\">\n  <div class=\"cc__col\">\n    <h2 class=\"cc__h\">{{parkHeading}}</h2>\n    <p class=\"cc__note\">{{parkNote}}</p>\n    <ul class=\"cc__sched\">{{#each schedule}}<li>{{#if name}}<strong>{{name}}</strong>{{/if}}{{detail}}</li>{{/each}}</ul>\n    <p class=\"cc__next\">{{#each nextDays}}<span class=\"cc__nd\" data-weekday=\"{{weekday}}\">{{label}}: <b></b></span>{{/each}}</p>\n  </div>\n  <div class=\"cc__col\">\n    <h2 class=\"cc__h\">{{callHeading}}</h2>\n    {{#link phoneLink}}<span class=\"cc__big\">{{phoneLabel}}</span>{{/link}}\n    {{#link emailLink}}<span class=\"cc__big\">{{emailLabel}}</span>{{/link}}\n    <p class=\"cc__addr\">{{address}}</p>\n    <div class=\"cc__social\">{{rich social}}</div>\n  </div>\n</div>",
  "css": ".cc { display: grid; gap: 2rem 3rem; }\n@media (min-width: 62rem) { .cc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.cc__h { font-size: 1.6rem; line-height: 1.08; letter-spacing: -.015em; margin: 0 0 .5em; }\n.cc__note { margin: 1em 0; max-width: 62ch; }\n.cc__sched { list-style: none; padding: 0; margin: .6rem 0 0; }\n.cc__sched li { margin: 0; padding: .15rem 0; max-width: 62ch; }\n.cc__sched strong { font-weight: 700; }\n.cc__next { margin: 1rem 0 1em; font-size: .95rem; color: var(--os-color-text-muted); max-width: 62ch; }\n.cc__nd { display: block; }\n.cc__nd b { color: var(--os-color-link); font-weight: 700; }\n.cc__col > a { --keep: 1; display: block !important; min-height: 0 !important; padding: .15rem 0; font-family: var(--os-font-heading); font-weight: 400; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.3rem); line-height: 1.2; color: var(--os-color-link); text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: .08em; }\n.cc__col > a:hover { text-decoration-thickness: .14em; }\n.cc__big { --keep: 1; display: inline; }\n.cc__addr { margin: 1rem 0 1em; max-width: 62ch; }\n.cc__social { font-size: .95rem; color: var(--os-color-text-muted); margin: 1em 0; }\n.cc__social p { margin: 0; max-width: 62ch; }\n.cc__social a { color: var(--os-color-link); }",
  "js": "var D=['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];root.querySelectorAll('.cc__nd').forEach(function(el){var d=D.indexOf(el.getAttribute('data-weekday'));if(d<0)return;var t=new Date(new Date().toLocaleString('en-US',{timeZone:'America/Denver'})),n=new Date(t.getFullYear(),t.getMonth(),t.getDate()+(d-t.getDay()+7)%7);el.querySelector('b').textContent=n.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'})});",
  "section": {
    "width": "content"
  },
  "ai": {
    "purpose": "Contact details: where to find the team in person, and how to reach them.",
    "whenToUse": "The contact page.",
    "avoid": "Repeating it on other pages."
  }
}
