{
  "name": "quote-carousel",
  "label": "Neighbor quotes",
  "description": "Large quotes from neighbors, one at a time, with previous/next buttons and dots. Only add a quote once the person has given written OK.",
  "version": 1,
  "category": "testimonials",
  "fields": {
    "heading": {
      "kind": "text",
      "label": "Heading (optional)",
      "optional": true,
      "maxLength": 80
    },
    "quotes": {
      "kind": "list",
      "label": "Quotes",
      "fields": {
        "context": {
          "kind": "text",
          "label": "Context (optional)",
          "optional": true,
          "maxLength": 120
        },
        "name": {
          "kind": "text",
          "label": "Who",
          "maxLength": 60
        },
        "quote": {
          "kind": "text",
          "label": "Quote",
          "maxLength": 300,
          "multiline": true
        },
        "video": {
          "kind": "link",
          "label": "Video of their story (optional)",
          "optional": true
        }
      }
    }
  },
  "defaults": {
    "heading": "In their words.",
    "quotes": [
      {
        "context": "",
        "name": "A neighbor",
        "quote": "I'm not just surviving. I'm borderline thriving."
      },
      {
        "context": "",
        "name": "A neighbor",
        "quote": "Boulder Feet Forward has been instrumental to the homelessness community and for myself and my family."
      },
      {
        "context": "",
        "name": "A neighbor",
        "quote": "They were able to help me whether it be find resources for food or clothing."
      }
    ]
  },
  "template": "<div class=\"qc\" role=\"group\" aria-roledescription=\"carousel\" aria-label=\"What our neighbors say\">{{#if heading}}<span class=\"qc__rule\" aria-hidden=\"true\"></span><h2 class=\"qc__h\">{{heading}}</h2>{{/if}}<div class=\"qc__track\" tabindex=\"0\">{{#each quotes}}<figure class=\"qc__q\" aria-roledescription=\"slide\"><blockquote><p class=\"qc__t\">“{{quote}}”</p></blockquote><figcaption><p class=\"qc__who\">{{name}}</p>{{#if context}}<p class=\"qc__ctx\">{{context}}</p>{{/if}}{{#if video}}{{#link video}}<span class=\"qc__watch\">Watch their story</span>{{/link}}{{/if}}</figcaption></figure>{{/each}}</div><div class=\"qc__ctl\"><button class=\"qc__b qc__prev\" type=\"button\" aria-label=\"Previous quote\">‹</button><button class=\"qc__b qc__next\" type=\"button\" aria-label=\"Next quote\">›</button><div class=\"qc__dots\"></div></div></div>",
  "css": ".qc__rule{display:block;width:3.5rem;height:3px;border-radius:3px;background:linear-gradient(90deg,#6b8e36,#eec02b);margin-bottom:clamp(1.4rem,3vw,2.2rem)}\n.qc__h{margin:0 0 1.6rem}\n.qc__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;transition:height .3s ease}\n.qc__track::-webkit-scrollbar{display:none}\n.qc__q{flex:0 0 100%;align-self:flex-start;scroll-snap-align:start;margin:0;padding-right:clamp(0rem,4vw,4rem)}\n.qc__q blockquote{margin:0}\n.qc__t{font-family:var(--os-font-heading);font-size:clamp(1.7rem,1rem + 3vw,3.3rem);line-height:1.14;letter-spacing:-.015em;max-width:24ch;text-wrap:balance;margin:0 0 1.4rem;color:var(--os-color-heading)}\n.qc__who{font-weight:700;margin:0}\n.qc__ctx{color:var(--os-color-text-muted);margin:.1rem 0 0}\n.qc__watch{display:inline-block;margin-top:.7rem;text-decoration:underline}\n.qc__ctl{display:flex;align-items:center;gap:1rem;margin-top:2rem}\n.qc__b{width:44px;height:44px;border-radius:999px;border:1px solid currentColor;background:transparent;color:var(--os-color-heading);font-size:1.6rem;line-height:1;cursor:pointer}\n.qc__b:disabled{opacity:.35;cursor:default}\n.qc__dots{display:flex}\n.qc__dots button{width:2.6rem;height:2.75rem;border:0;padding:0;background:transparent;cursor:pointer;position:relative}\n.qc__dots button::before{content:'';position:absolute;left:50%;top:50%;width:.8rem;height:.8rem;border-radius:999px;background:rgba(21,38,26,.22);transform:translate(-50%,-50%);transition:width .25s,background .25s}\n.qc__dots button[aria-selected=true]::before{background:#6b8e36;width:1.4rem}\n@media (prefers-reduced-motion: reduce){.qc__track,.qc__dots button::before{transition:none}}",
  "js": "var t=root.querySelector('.qc__track');if(!t)return;var s=[].slice.call(t.children),dw=root.querySelector('.qc__dots'),p=root.querySelector('.qc__prev'),n=root.querySelector('.qc__next'),i=0,ds=[];if(s.length<2){root.querySelector('.qc__ctl').style.display='none';return}t.style.overflow='hidden';s.forEach(function(x,k){var b=document.createElement('button');b.type='button';b.setAttribute('role','tab');b.setAttribute('aria-label','Quote '+(k+1));b.addEventListener('click',function(){go(k)});dw.appendChild(b);ds.push(b)});function fit(){t.style.height=s[i].offsetHeight+'px'}function mark(k){i=k;ds.forEach(function(d,m){d.setAttribute('aria-selected',m===k?'true':'false')});p.disabled=k===0;n.disabled=k===s.length-1;fit()}function go(k){k=Math.max(0,Math.min(s.length-1,k));t.scrollTo({left:s[k].offsetLeft-t.offsetLeft,behavior:ctx.reducedMotion?'auto':'smooth'});mark(k)}p.addEventListener('click',function(){go(i-1)});n.addEventListener('click',function(){go(i+1)});var x0=0,y0=0;t.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;y0=e.touches[0].clientY},{passive:true});t.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-x0,dy=e.changedTouches[0].clientY-y0;if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)*1.5)go(i+(dx<0?1:-1))},{passive:true});t.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){e.preventDefault();go(i+1)}else if(e.key==='ArrowLeft'){e.preventDefault();go(i-1)}});addEventListener('resize',function(){fit();t.scrollTo({left:s[i].offsetLeft-t.offsetLeft})});mark(0);",
  "section": {
    "width": "content"
  },
  "ai": {
    "purpose": "Real quotes from neighbors, shown one at a time.",
    "whenToUse": "Home and Impact pages, once the people quoted have given written OK.",
    "avoid": "Quotes without written consent; invented quotes."
  }
}
