{
  "name": "bff-story",
  "label": "Story with list and pivot line",
  "description": "A heading, an intro, a two-column list, a closing paragraph and a large pivot line.",
  "version": 1,
  "category": "text",
  "fields": {
    "heading": {
      "kind": "text",
      "label": "Heading",
      "maxLength": 120
    },
    "intro": {
      "kind": "text",
      "label": "Intro",
      "maxLength": 400,
      "multiline": true
    },
    "items": {
      "kind": "list",
      "label": "List",
      "fields": {
        "text": {
          "kind": "text",
          "label": "Item",
          "maxLength": 120
        }
      }
    },
    "outro": {
      "kind": "text",
      "label": "Closing paragraph",
      "optional": true,
      "maxLength": 400,
      "multiline": true
    },
    "pivot": {
      "kind": "text",
      "label": "Large pivot line",
      "optional": true,
      "maxLength": 120
    }
  },
  "defaults": {
    "heading": "When systems fail, people fall through the gaps.",
    "intro": "Many of the people we meet have been failed by a system, sometimes over a whole lifetime. Often more than one:",
    "items": [
      {
        "text": "Child protection and foster care"
      },
      {
        "text": "Family and intimate-partner violence"
      },
      {
        "text": "The legal and criminal justice systems"
      },
      {
        "text": "Substance use and the opioid epidemic"
      },
      {
        "text": "Behavioral health care"
      },
      {
        "text": "Medical care"
      },
      {
        "text": "Financial systems"
      },
      {
        "text": "Climate disaster and food insecurity"
      }
    ],
    "outro": "Services exist, but they are not always within reach of the people who need them most. People tell us they have given up asking for help.",
    "pivot": "Sometimes, we’re able to change that."
  },
  "template": "<div class=\"bs\"><h2 class=\"bs__h\">{{heading}}</h2><p class=\"bs__p\">{{intro}}</p><ul class=\"bs__l\">{{#each items}}<li>{{text}}</li>{{/each}}</ul>{{#if outro}}<p class=\"bs__p bs__o\">{{outro}}</p>{{/if}}{{#if pivot}}<p class=\"bs__pv\">{{pivot}}</p>{{/if}}</div>",
  "css": ".bs__h{margin:0 0 .5em;font-family:var(--os-font-heading);font-weight:380;font-size:clamp(2.1rem,1.2rem + 3.4vw,3.7rem);line-height:1.08;letter-spacing:-.015em;text-wrap:balance;color:var(--os-color-heading)}\n.bs__p{max-width:62ch;margin:1em 0}\n.bs__l{columns:2 16rem;column-gap:2.5rem;margin:1.2rem 0 0;padding:0;list-style:none;font-size:1.05rem;color:var(--os-color-text-muted)}\n.bs__l li{break-inside:avoid;padding:.15rem 0}\n.bs__o{margin-top:1.4rem}\n.bs__pv{--keep:1;font-family:var(--os-font-heading);font-weight:400;font-size:clamp(2rem,1rem + 4vw,4rem);line-height:1.05;max-width:16ch;margin:clamp(2.2rem,5vw,4rem) 0 0;color:var(--os-color-heading)}",
  "section": {
    "width": "content"
  },
  "ai": {
    "purpose": "A short story beat with a list and a turning-point line.",
    "whenToUse": "Home page, after the hero.",
    "avoid": "Long lists (keep under ten)."
  }
}
